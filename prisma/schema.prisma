generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BotMatchResults {
  id                                  Int      @id @default(autoincrement())
  BotOneID                            Int
  BotTwoID                            Int
  PuzzleID                            Int
  History                             Json     @default("[]") @db.Json
  Score                               Int?
  createdAt                           DateTime @default(now()) @db.Timestamptz(6)
  updatedAt                           DateTime @default(now()) @db.Timestamptz(6)
  Bots_BotMatchResults_BotOneIDToBots Bots     @relation("BotMatchResults_BotOneIDToBots", fields: [BotOneID], references: [id], onDelete: Cascade)
  Bots_BotMatchResults_BotTwoIDToBots Bots     @relation("BotMatchResults_BotTwoIDToBots", fields: [BotTwoID], references: [id], onDelete: Cascade)
  Puzzles                             Puzzles  @relation(fields: [PuzzleID], references: [id], onDelete: Cascade)
}

model Bots {
  id                                             Int               @id @default(autoincrement())
  UserID                                         Int?
  Name                                           String?
  Model                                          String?
  Prompt                                         String?
  RemainingGames                                 BigInt?
  createdAt                                      DateTime?         @db.Timestamptz(6)
  updatedAt                                      DateTime?         @db.Timestamptz(6)
  BotMatchResults_BotMatchResults_BotOneIDToBots BotMatchResults[] @relation("BotMatchResults_BotOneIDToBots")
  BotMatchResults_BotMatchResults_BotTwoIDToBots BotMatchResults[] @relation("BotMatchResults_BotTwoIDToBots")
  Users                                          Users?            @relation(fields: [UserID], references: [id], onDelete: Cascade)
}

model Puzzles {
  id              Int               @id @default(autoincrement())
  title           String?           @db.VarChar(255)
  fen             String?           @db.VarChar(255)
  createdAt       DateTime          @db.Timestamptz(6)
  updatedAt       DateTime          @db.Timestamptz(6)
  BotMatchResults BotMatchResults[]
  UserScores      UserScores[]
}

model SequelizeMeta {
  name String @id @db.VarChar(255)
}

model UserScores {
  id             Int      @id @default(autoincrement())
  UserId         Int
  PuzzleId       Int
  score          Int?
  model          String?  @db.VarChar(255)
  prompt         String?  @db.VarChar(255)
  turnsRemaining Int?
  createdAt      DateTime @db.Timestamptz(6)
  updatedAt      DateTime @db.Timestamptz(6)
  Puzzles        Puzzles  @relation(fields: [PuzzleId], references: [id], onDelete: Cascade)
  Users          Users    @relation(fields: [UserId], references: [id], onDelete: Cascade)
}

model Users {
  id            Int          @id @default(autoincrement())
  sub           String       @unique @db.VarChar(255)
  username      String?      @unique @db.VarChar(255)
  name          String?      @db.VarChar(255)
  email         String?      @unique @db.VarChar(255)
  emailVerified Boolean?
  image         String?
  createdAt     DateTime     @db.Timestamptz(6)
  updatedAt     DateTime     @db.Timestamptz(6)
  Bots          Bots[]
  UserScores    UserScores[]
}
